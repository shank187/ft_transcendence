// backend/prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

// Onboarding / training profile

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingGoal {
  BUILD_MUSCLE
  GAIN_STRENGTH
  LOSE_FAT
  IMPROVE_GENERAL_FITNESS
  IMPROVE_ENDURANCE
  MAINTAIN_FITNESS
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum ExerciseType {
  WEIGHT_REPS
  BODYWEIGHT_REPS
  WEIGHTED_BODYWEIGHT
  ASSISTED_BODYWEIGHT
  DURATION
  WEIGHT_DURATION
  DISTANCE_DURATION
}

enum WorkoutPlanType {
  CUSTOM
  RECOMMENDED
}

enum WorkoutSetType {
  NORMAL
  HEAVY
  WARMUP
  DROP
  FAILURE
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Gyms

enum GymVisibility {
  PUBLIC
  PRIVATE
}

enum GymSource {
  TEAM
  IMPORTED
  MEMBER
}

enum EquipmentCategory {
  FREE_WEIGHTS
  BENCHES_RACKS
  MACHINES
  CABLES_ATTACHMENTS
  CARDIO
  ACCESSORIES
  OTHER
}

enum GymSubmissionKind {
  NEW_GYM
  VERIFY
  CORRECTION
}

enum GymSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GymRejectReason {
  ALREADY_LISTED
  NOT_A_GYM
  CANT_CONFIRM
  OTHER
}

// Rewards

enum XpReason {
  WORKOUT_COMPLETED
  PR_SET
  GYM_APPROVED
}

// ============================================================
// IDENTITY
// ============================================================

model PendingRegistration {
  id           String   @id @default(uuid())
  username     String
  email        String   @unique
  passwordHash String
  codeHash     String
  expiresAt    DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([email])
}

model User {
  id                    String           @id @default(uuid())
  email                 String           @unique
  username              String           @unique
  passwordHash          String?
  googleId              String?          @unique
  displayName           String?
  avatarUrl             String?
  bio                   String?
  lastSeenAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  experienceLevel       ExperienceLevel?
  primaryGoal           TrainingGoal?
  unitSystem            UnitSystem       @default(METRIC)
  heightCm              Float?
  weightKg              Float?
  onboardingCompletedAt DateTime?

  // Identity / authentication
  roles    UserRole[]
  sessions Session[]

