// backend/prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

// Onboarding / training profile

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingGoal {
  BUILD_MUSCLE
  GAIN_STRENGTH
  LOSE_FAT
  IMPROVE_GENERAL_FITNESS
  IMPROVE_ENDURANCE
  MAINTAIN_FITNESS
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum ExerciseType {
  WEIGHT_REPS
  BODYWEIGHT_REPS
  WEIGHTED_BODYWEIGHT
  ASSISTED_BODYWEIGHT
  DURATION
  WEIGHT_DURATION
  DISTANCE_DURATION
}

enum WorkoutPlanType {
  CUSTOM
  RECOMMENDED
}

enum WorkoutSetType {
  NORMAL
  HEAVY
  WARMUP
  DROP
  FAILURE
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================================
// IDENTITY
// ============================================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  refreshToken String?
  displayName  String?
  avatarUrl    String?
  bio          String?
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt


  experienceLevel      ExperienceLevel?
  primaryGoal           TrainingGoal?
  unitSystem            UnitSystem        @default(METRIC)
  heightCm              Float?
  weightKg              Float?
  onboardingCompletedAt DateTime?



  // Identity / authentication
  roles    UserRole[]
  sessions Session[]

  // Gym
  createdGyms Gym[]
  gymReviews  GymReview[]

  // Workouts
  workoutPlans    WorkoutPlan[]
  workoutSessions WorkoutSession[]

  // Social
  sentFriendships     Friendship[] @relation("FriendshipRequester")
  receivedFriendships Friendship[] @relation("FriendshipAddressee")

  conversationMembers ConversationMember[]
  messages            Message[]

  // Shared
  notifications Notification[]
  media         Media[]
  apiKeys       ApiKey[]
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// GYMS
// ============================================================

model Gym {
  id          String   @id @default(uuid())
  name        String
  description String?
  address     String?
  city        String?
  latitude    Float?
  longitude   Float?
  phone       String?
  website     String?
  verified    Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  openingHours GymOpeningHour[]
  equipment    GymEquipment[]
  facilities   GymFacility[]
  reviews      GymReview[]

  @@index([city])
  @@index([createdById])
}

model GymOpeningHour {
  id        String    @id @default(uuid())
  gymId     String
  dayOfWeek DayOfWeek
  opensAt   String
  closesAt  String

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, dayOfWeek])
}

model Equipment {
  id       String  @id @default(uuid())
  name     String  @unique
  imageUrl String?

  gyms          GymEquipment[]
  exerciseLinks ExerciseEquipment[]
}

model GymEquipment {
  gymId       String
  equipmentId String
  quantity    Int?

  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([gymId, equipmentId])
}

model Facility {
  id   String @id @default(uuid())
  name String @unique

  gyms GymFacility[]
}

model GymFacility {
  gymId      String
  facilityId String

  gym      Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([gymId, facilityId])
}

model GymReview {
  id        String   @id @default(uuid())
  gymId     String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId])
  @@index([gymId])
  @@index([userId])
}

// ============================================================
// FITNESS / WORKOUTS
// ============================================================

// ------------------------------------------------------------
// EXERCISE CATALOG
// ------------------------------------------------------------

model MuscleGroup {
  id   String @id @default(uuid())
  name String @unique

  primaryExercises   Exercise[]                @relation("PrimaryMuscle")
  secondaryExercises ExerciseSecondaryMuscle[]
}

model Exercise {
  id                   String       @id @default(uuid())
  name                 String       @unique
  description          String?
  type                 ExerciseType
  primaryMuscleGroupId String

  imageUrl String?
  demoUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryMuscleGroup MuscleGroup @relation("PrimaryMuscle", fields: [primaryMuscleGroupId], references: [id], onDelete: Restrict)

  secondaryMuscles ExerciseSecondaryMuscle[]
  equipment        ExerciseEquipment[]

  workoutExercises WorkoutExercise[]
  sessionExercises WorkoutSessionExercise[]

  @@index([primaryMuscleGroupId])
}

model ExerciseSecondaryMuscle {
  exerciseId    String
  muscleGroupId String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
}

model ExerciseEquipment {
  exerciseId  String
  equipmentId String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([exerciseId, equipmentId])
  @@index([equipmentId])
}

// ------------------------------------------------------------
// WORKOUT PLANNING
// ------------------------------------------------------------

model WorkoutPlan {
  id          String          @id @default(uuid())
  userId      String?
  name        String
  description String?
  type        WorkoutPlanType @default(CUSTOM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  days WorkoutDay[]

  @@index([userId])
  @@index([type])
}

model WorkoutDay {
  id            String @id @default(uuid())
  workoutPlanId String
  name          String
  dayOrder      Int

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)

  exercises WorkoutExercise[]
  sessions  WorkoutSession[]

  @@unique([workoutPlanId, dayOrder])
}

model WorkoutExercise {
  id           String @id @default(uuid())
  workoutDayId String
  exerciseId   String

  order Int

  notes String?

  // null = no automatic rest timer
  restSeconds Int?

  // null = normal standalone exercise.
  // Same number means exercises belong to same superset/circuit.
  supersetGroup Int?

  workoutDay WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  sets WorkoutExerciseSet[]

  @@unique([workoutDayId, order])
  @@index([exerciseId])
}

model WorkoutExerciseSet {
  id                String @id @default(uuid())
  workoutExerciseId String

  setNumber Int
  setType   WorkoutSetType @default(NORMAL)

  targetWeight   Float?
  targetReps     Int?
  targetDuration Int?
  targetDistance Float?

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseId, setNumber])
}

// ------------------------------------------------------------
// WORKOUT EXECUTION
// ------------------------------------------------------------

model WorkoutSession {
  id     String @id @default(uuid())
  userId String

  workoutDayId String?

  status WorkoutSessionStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Snapshot of user's body weight when this workout started.
  bodyWeightKg Float?

  notes String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  workoutDay WorkoutDay? @relation(fields: [workoutDayId], references: [id], onDelete: SetNull)

  exercises WorkoutSessionExercise[]

  @@index([userId])
  @@index([workoutDayId])
  @@index([startedAt])
  @@index([userId, status])
}

model WorkoutSessionExercise {
  id               String @id @default(uuid())
  workoutSessionId String
  exerciseId       String

  order Int

  notes String?

  // Snapshot of the timer configuration for TODAY.
  // null = timer disabled.
  restSeconds Int?

  // Can differ from the saved routine during this session.
  supersetGroup Int?

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  sets WorkoutSet[]

  @@unique([workoutSessionId, order])
  @@index([exerciseId])
}

model WorkoutSet {
  id                       String @id @default(uuid())
  workoutSessionExerciseId String

  setNumber Int
  setType   WorkoutSetType @default(NORMAL)

  // Snapshot of routine targets when the workout starts.
  plannedWeight   Float?
  plannedReps     Int?
  plannedDuration Int?
  plannedDistance Float?

  // What the user actually performs.
  weight   Float?
  reps     Int?
  duration Int?
  distance Float?

  // null = not completed yet
  completedAt DateTime?

  workoutSessionExercise WorkoutSessionExercise @relation(fields: [workoutSessionExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutSessionExerciseId, setNumber])
}

// ============================================================
// SOCIAL
// ============================================================

model Friendship {
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@id([requesterId, addresseeId])
  @@index([addresseeId])
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ============================================================
// SHARED INFRASTRUCTURE
// ============================================================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  content   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  metadata  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model Media {
  id           String    @id @default(uuid())
  uploadedById String
  url          String
  type         MediaType
  mimeType     String?
  size         Int?
  metadata     Json?
  createdAt    DateTime  @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([uploadedById])
}

model ApiKey {
  id        String    @id @default(uuid())
  userId    String
  name      String
  keyHash   String    @unique
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
