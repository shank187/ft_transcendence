model GymOpeningHour {
  id        String    @id @default(uuid())
  gymId     String
  dayOfWeek DayOfWeek
  opensAt   String
  closesAt  String

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, dayOfWeek])
}

model Equipment {
  id       String            @id @default(uuid())
  name     String            @unique
  imageUrl String?
  category EquipmentCategory @default(OTHER)

  gyms          GymEquipment[]
  exerciseLinks ExerciseEquipment[]
  submissions   GymSubmissionEquipment[]
}

model GymEquipment {
  gymId       String
  equipmentId String
  quantity    Int?

  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([gymId, equipmentId])
}

model Facility {
  id   String @id @default(uuid())
  name String @unique

  gyms GymFacility[]
}

model GymFacility {
  gymId      String
  facilityId String

  gym      Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([gymId, facilityId])
}

model GymReview {
  id        String   @id @default(uuid())
  gymId     String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId])
  @@index([gymId])
  @@index([userId])
}

model GymSubmission {
  id               String              @id @default(uuid())
  kind             GymSubmissionKind
  status           GymSubmissionStatus @default(PENDING)
  submitterId      String
  gymId            String? // the gym it's about; for NEW_GYM, set to the gym created on approval
  privateCopyId    String? // the member's private copy, if they kept one
  name             String?
  city             String?
  address          String?
  closed           Boolean             @default(false)
  note             String?
  seenOn           DateTime?           @db.Date
  baseGymUpdatedAt DateTime? // gym.updatedAt when the form opened; approve returns 409 if it changed
  reviewerId       String?
  reviewedAt       DateTime?
  rejectReason     GymRejectReason?
  rejectDetail     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  submitter   User                     @relation("Submitter", fields: [submitterId], references: [id], onDelete: Cascade)
  reviewer    User?                    @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  gym         Gym?                     @relation("SubmissionGym", fields: [gymId], references: [id], onDelete: SetNull)
  privateCopy Gym?                     @relation("SubmissionPrivateCopy", fields: [privateCopyId], references: [id], onDelete: SetNull)
  equipment   GymSubmissionEquipment[]
  photos      GymSubmissionPhoto[]

  @@index([status, createdAt])
  @@index([submitterId, createdAt])
  @@index([gymId, status])
}

// The full proposed list, not a diff.
model GymSubmissionEquipment {
  submissionId String
  equipmentId  String

  submission GymSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  equipment  Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@id([submissionId, equipmentId])
}

// Links the existing Media table.
model GymSubmissionPhoto {
  submissionId String
  mediaId      String @unique
  position     Int

  submission GymSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  media      Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([submissionId, position])
}

// ============================================================
// FITNESS / WORKOUTS
// ============================================================

// ------------------------------------------------------------
// EXERCISE CATALOG
// ------------------------------------------------------------

model MuscleGroup {
  id   String @id @default(uuid())
  name String @unique

  primaryExercises   Exercise[]                @relation("PrimaryMuscle")
  secondaryExercises ExerciseSecondaryMuscle[]
}

model Exercise {
  id                   String       @id @default(uuid())
  name                 String       @unique
  description          String?
  type                 ExerciseType
  primaryMuscleGroupId String

  imageUrl String?
  demoUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryMuscleGroup MuscleGroup @relation("PrimaryMuscle", fields: [primaryMuscleGroupId], references: [id], onDelete: Restrict)

  secondaryMuscles ExerciseSecondaryMuscle[]
  equipment        ExerciseEquipment[]

  workoutExercises WorkoutExercise[]
  sessionExercises WorkoutSessionExercise[]

  @@index([primaryMuscleGroupId])
}

model ExerciseSecondaryMuscle {
  exerciseId    String
  muscleGroupId String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
}

model ExerciseEquipment {
  exerciseId  String
  equipmentId String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([exerciseId, equipmentId])
  @@index([equipmentId])
}

// ------------------------------------------------------------
// WORKOUT PLANNING
// ------------------------------------------------------------

model WorkoutPlan {
  id          String          @id @default(uuid())
  userId      String?
  name        String
  description String?
  type        WorkoutPlanType @default(CUSTOM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  days WorkoutDay[]

  @@index([userId])
  @@index([type])
}

model WorkoutDay {
  id            String @id @default(uuid())
  workoutPlanId String
  name          String
  dayOrder      Int

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)

  exercises WorkoutExercise[]
  sessions  WorkoutSession[]

  @@unique([workoutPlanId, dayOrder])
}

model WorkoutExercise {
  id           String @id @default(uuid())
  workoutDayId String
  exerciseId   String

  order Int

  notes String?

  // null = no automatic rest timer
  restSeconds Int?

  // null = normal standalone exercise.
  // Same number means exercises belong to same superset/circuit.
  supersetGroup Int?

  workoutDay WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  sets WorkoutExerciseSet[]

  @@unique([workoutDayId, order])
  @@index([exerciseId])
}

model WorkoutExerciseSet {
  id                String @id @default(uuid())
  workoutExerciseId String

  setNumber Int
  setType   WorkoutSetType @default(NORMAL)

  targetWeight   Float?
  targetReps     Int?
  targetDuration Int?
  targetDistance Float?

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseId, setNumber])
}

// ------------------------------------------------------------
// WORKOUT EXECUTION
// ------------------------------------------------------------

model WorkoutSession {
  id     String @id @default(uuid())
  userId String

  workoutDayId String?

  status WorkoutSessionStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Snapshot of user's body weight when this workout started.
  bodyWeightKg Float?

  notes String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  workoutDay WorkoutDay? @relation(fields: [workoutDayId], references: [id], onDelete: SetNull)

  exercises WorkoutSessionExercise[]

  @@index([userId])
  @@index([workoutDayId])
  @@index([startedAt])
  @@index([userId, status])
}

model WorkoutSessionExercise {
  id               String @id @default(uuid())
  workoutSessionId String
  exerciseId       String

  order Int

  notes String?

  // Snapshot of the timer configuration for TODAY.
  // null = timer disabled.
  restSeconds Int?

  // Can differ from the saved routine during this session.
  supersetGroup Int?

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  sets WorkoutSet[]

  @@unique([workoutSessionId, order])
  @@index([exerciseId])
}

model WorkoutSet {
  id                       String @id @default(uuid())
  workoutSessionExerciseId String

  setNumber Int
  setType   WorkoutSetType @default(NORMAL)

  // Snapshot of routine targets when the workout starts.
  plannedWeight   Float?
  plannedReps     Int?
  plannedDuration Int?
  plannedDistance Float?

  // What the user actually performs.
  weight   Float?
  reps     Int?
  duration Int?
  distance Float?

  // null = not completed yet
  completedAt DateTime?

  // Set by S3 when the workout finishes.
  isPr Boolean @default(false)

  workoutSessionExercise WorkoutSessionExercise @relation(fields: [workoutSessionExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutSessionExerciseId, setNumber])
}

// ============================================================
// SOCIAL
// ============================================================

model Friendship {
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  blockedById String?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@id([requesterId, addresseeId])
  @@index([addresseeId])
}

model Conversation {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1 User @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([user1Id, user2Id])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ============================================================
// REWARDS (S5)
// ============================================================

// One row per reward; total XP = the sum.
model XpEvent {
  id        String   @id @default(uuid())
  userId    String
  reason    XpReason
  sourceId  String // session ID, workout set ID or gym submission ID
  amount    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reason, sourceId]) // nothing pays twice
  @@index([userId])
}

// The unlock moment; progress like 7/10 is computed.
model UserAchievement {
  userId     String
  code       String // e.g. WORKOUTS_10, defined in S5's rules config
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, code])
}

// ============================================================
// SHARED INFRASTRUCTURE
// ============================================================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  content   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  metadata  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model Media {
  id           String    @id @default(uuid())
  uploadedById String
  url          String
  type         MediaType
  mimeType     String?
  size         Int?
  metadata     Json?
  createdAt    DateTime  @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  gymSubmissionPhoto GymSubmissionPhoto?

  @@index([uploadedById])
}

model ApiKey {
  id        String    @id @default(uuid())
  userId    String
  name      String
  keyHash   String    @unique
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
